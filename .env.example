# Copy to .env.local for local development. Never commit real keys.
# Server-side only: read by the AI proxy, never bundled into the app.
ANTHROPIC_API_KEY=
# Optional: model override (defaults to claude-haiku-5-5, the small fast tier)
AI_MODEL=
# Optional: if set, the app must send this code (entered in Settings) to use live AI.
APP_ACCESS_CODE=
